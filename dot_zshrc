export ZSH_CONFIG_DIR="$HOME/.config/zsh"

source_if_exists() {
  [ -f "$1" ] && source "$1"
}

source_if_exists "$ZSH_CONFIG_DIR/options.zsh"
source_if_exists "$ZSH_CONFIG_DIR/exports.zsh"
source_if_exists "$ZSH_CONFIG_DIR/completions.zsh"
source_if_exists "$ZSH_CONFIG_DIR/plugins.zsh"
source_if_exists "$ZSH_CONFIG_DIR/keybindings.zsh"
source_if_exists "$ZSH_CONFIG_DIR/fzf.zsh"
source_if_exists "$ZSH_CONFIG_DIR/aliases.zsh"
source_if_exists "$ZSH_CONFIG_DIR/functions.zsh"
source_if_exists "$ZSH_CONFIG_DIR/prompt.zsh"
source_if_exists "$ZSH_CONFIG_DIR/secrets.zsh"
